{
  "name": "@use-reacty/docs",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:dev": "pnpm docs:gen && vitepress dev docs --port 3000",
    "docs:gen": "tsx ./scripts/docsGen.ts",
    "dev": "pnpm -r --parallel run \"/^(docs:dev|dev)$/\"",
    "build": "pnpm --filter use-reacty build && pnpm docs:gen && vitepress build docs",
    "preview": "vitepress preview docs",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.2.0",
    "use-reacty": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
